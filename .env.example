# Insurance Lead Engine — Variáveis de Ambiente & Produção
# Em desenvolvimento local: "file:./dev.db" (SQLite)
# Em produção SaaS: "postgresql://usuario:senha@host:5432/banco?schema=public" (Supabase / Neon / AWS RDS)
DATABASE_URL="file:./dev.db"

# Segredo criptográfico de sessão (Mínimo de 32 caracteres obrigatórios)
SESSION_SECRET="sua-chave-secreta-de-sessao-com-minimo-de-32-caracteres"

# Provedores de IA para Lead Scoring, Cotações e Assistente Virtual
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# Telefonia / Voz com IA (Opcional - Vapi Voice)
VAPI_API_KEY=""
VAPI_ASSISTANT_ID=""

# Disparo Multicanal (WhatsApp / SMS - Opcional)
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_ID=""
